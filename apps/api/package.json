{
  "name": "@harbor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && tsx watch src/server.ts",
    "build": "node init && tsup",
    "start": "node init && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run src/__security__",
    "db:sync-indexes": "tsx src/core/db/sync-indexes.ts",
    "auth:handshake": "tsx scripts/auth-handshake.ts",
    "seed:demo": "tsx src/features/demo/seed-demo.ts",
    "reset:demo": "tsx src/features/demo/reset-demo.ts",
    "evidence:export": "tsx src/features/evidence/export-evidence.ts"
  },
  "dependencies": {
    "@harbor/contracts": "workspace:*",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.12",
    "mongoose": "^8.12.1",
    "multer": "^2.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
